{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://herbal-oil.skill/schemas/evidence.schema.json",
  "title": "EvidenceBundle",
  "description": "Output of the evidence-collector agent (Step 2).",
  "type": "object",
  "required": ["evidence", "coverage"],
  "additionalProperties": false,
  "properties": {
    "current_data": {"type": "array", "items": {"type": "object"}},
    "authoritative_docs": {"type": "array", "items": {"type": "object"}},
    "recent_news": {"type": "array", "items": {"type": "object"}},
    "reference_benchmarks": {"type": "array", "items": {"type": "object"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "tier"],
        "properties": {
          "source": {"type": "string"},
          "tier": {"type": "integer", "minimum": 1, "maximum": 4},
          "url": {"type": "string"},
          "accessed_at": {"type": "string"},
          "claim": {"type": "string"}
        }
      }
    },
    "coverage": {"type": "string", "enum": ["Strong", "Moderate", "Weak"]},
    "degradation": {"type": "string"}
  }
}