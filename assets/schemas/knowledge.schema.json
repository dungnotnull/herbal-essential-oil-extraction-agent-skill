{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://herbal-oil.skill/schemas/knowledge.schema.json",
  "title": "KnowledgeEvidence",
  "description": "Output of the knowledge-updater agent (Step 4).",
  "type": "object",
  "required": ["citations", "coverage"],
  "additionalProperties": true,
  "properties": {
    "citations": {"type": "array", "items": {"type": "string"}, "minItems": 0},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "coverage": {"type": "string", "enum": ["Strong", "Moderate", "Weak"]}
  }
}